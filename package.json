{
  "name": "vesage-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsr generate && tsc --noEmit && vite build",
    "typecheck": "tsr generate && tsc --noEmit",
    "dev": "bun run build && wrangler dev --local",
    "preview": "wrangler dev --local",
    "db:local": "wrangler d1 migrations apply vesage-inquiries --local",
    "db:remote": "wrangler d1 migrations apply vesage-inquiries --remote",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-router": "1.170.17",
    "@tanstack/react-start": "1.168.27",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260708.1",
    "@tailwindcss/vite": "4.3.2",
    "@tanstack/router-cli": "1.167.18",
    "@types/node": "26.1.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vite": "8.1.3",
    "wrangler": "^4.0.0"
  },
  "overrides": { "@types/react": "19.2.15" }
}
